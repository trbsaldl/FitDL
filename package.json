{
  "name": "fitdl-app",
  "version": "3.28.0",
  "private": true,
  "description": "FitDL: tu entrenador de fitness personal (calorías, macros, diario, Coach, menú, lista de la compra, progreso y gym)",
  "scripts": {
    "start": "node tools/serve.js",
    "css": "node tools/build-css.js",
    "icons": "node tools/build-icons.js",
    "build": "node tools/build-icons.js && node tools/build-css.js && node tools/build-sw.js",
    "test": "node --test",
    "seo": "node tools/seo/paginas.js",
    "i18n": "node tools/i18n-check.js",
    "lint": "eslint js tests tools eslint.config.js",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "postcss-selector-parser": "6.1.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19"
  }
}
